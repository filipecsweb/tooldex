{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tooldex",
  "account_id": "d5f715c012463143e5a859636403780f", // personal account
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Custom domain: wrangler deploy creates the DNS record and certificate on the hellofilipe.dev zone (same account).
  "routes": [{ "pattern": "tooldex.hellofilipe.dev", "custom_domain": true }],
  // Routes would infer workers_dev: false; keep the old URL answering. Its pages canonicalise to the custom domain.
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true }
}
