---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Seo from '../components/Seo.astro';
import Masthead from '../components/Masthead.astro';
import { getCategories } from '../lib/data';
import { SITE } from '../site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}
const { title, description, image, jsonLd, noindex } = Astro.props;
const sections = await getCategories();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#e9eae7" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Seo title={title} description={description} image={image} jsonLd={jsonLd} noindex={noindex} />
    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-ink focus:px-3 focus:py-2 focus:text-paper">Skip to content</a>
    <slot name="masthead"><Masthead /></slot>
    <main id="main" class="mx-auto max-w-[1320px] px-4 pb-24 sm:px-6">
      <slot />
    </main>
    <footer class="mx-auto max-w-[1320px] px-4 pb-12 sm:px-6">
      <div class="rule-4 grid gap-10 pt-6 md:grid-cols-12">
        <div class="md:col-span-5">
          <a href="/" class="text-[2.125rem] font-black leading-none tracking-[-0.045em] text-ink no-underline">{SITE.name}</a>
          <p class="mt-3 max-w-[44ch] font-serif text-[1rem] leading-[1.55] text-ink-2">
            {SITE.tagline} Every entry links to the tool's own website or repository, which is the source of truth for install steps and details.
          </p>
        </div>
        <nav aria-label="Sections" class="md:col-span-7">
          <h2 class="text-[0.9375rem] font-extrabold">Sections</h2>
          <ul class="mt-3 grid gap-x-8 gap-y-2 sm:grid-cols-2">
            {sections.map((s) => (
              <li class="flex items-baseline justify-between gap-3">
                <a href={`/categories/${s.id}`} class="font-semibold text-ink no-underline hover:underline">{s.data.name}</a>
                <span class="text-[0.875rem] text-ink-3">{s.count}</span>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </footer>
  </body>
</html>
