---
import '../styles/global.css';
import css from '../styles/global.css?raw';
import { ClientRouter } from 'astro:transitions';
import Seo from '../components/Seo.astro';
import { getCategories } from '../lib/data';
import { SITE } from '../site';
import { SLASH_MEDIA, SLASH_OFF } from '../lib/slash';
// The two faces every page sets first; preloading them keeps the fallback swap from shifting the layout.
import geist from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import geistMono from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}
const { title, description, image, imageAlt, jsonLd, noindex } = Astro.props;
const sections = await getCategories();
// The browser chrome takes the page's ground colour, read from its one definition in @theme.
const ground = css.match(/--color-ground:\s*([^;]+);/)![1].trim();
const nav = [
  ['Catalog', '/'],
  ['Sections', '/categories'],
] as const;
const here = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/');
// The page itself is "page"; a page inside the section (a section page under /categories) is "true".
const current = (href: string) => (here === href ? 'page' : href !== '/' && here.startsWith(`${href}/`) ? 'true' : undefined);
// Home has its own large search; every other page gets the compact one in the header.
const headerSearch = here !== '/';
const searchIcon = 'M20 20l-3.5-3.5M18 11a7 7 0 1 1-14 0 7 7 0 0 1 14 0z';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={ground} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={geist} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistMono} as="font" type="font/woff2" crossorigin />
    <Seo title={title} description={description} image={image} imageAlt={imageAlt} jsonLd={jsonLd} noindex={noindex} />
    <ClientRouter />
    <script is:inline define:vars={{ key: SLASH_OFF, media: SLASH_MEDIA }}>
      // Whether the "/" shortcut exists here (data-slash-available: its switch shows) and is on
      // (data-slash: its key hints show), decided before first paint so neither flashes; the rule is
      // src/lib/slash.ts's. Navigation swaps <html>'s attributes, so they are set again after each swap.
      const set = () => {
        const available = matchMedia(media).matches;
        let on = available;
        try { on = available && localStorage.getItem(key) === null; } catch { /* storage blocked: on wherever available */ }
        document.documentElement.toggleAttribute('data-slash-available', available);
        document.documentElement.toggleAttribute('data-slash', on);
      };
      set();
      document.addEventListener('astro:after-swap', set);
    </script>
  </head>
  <body class="flex flex-col">
    <a href="#main" class="sr-only rounded-control bg-ink px-3 py-2 text-ui font-medium text-surface focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50">Skip to content</a>
    <header class="border-b border-line bg-surface">
      <div class="mx-auto flex min-h-16 max-w-sheet flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 md:px-8">
        <a href="/" class="text-wordmark text-ink no-underline hover:text-ink pointer-coarse:py-3.5">{SITE.name}</a>
        {headerSearch && (
          <>
            <form action="/" method="get" role="search" class="ml-auto hidden h-10 w-85 min-w-0 items-center gap-2.5 rounded-control border border-line-strong bg-ground px-3 transition-[border-color,box-shadow] duration-150 focus-within:border-accent focus-within:shadow-halo md:flex">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="flex-none text-meta"><path d={searchIcon} /></svg>
              <label for="site-q" class="sr-only">Search the catalog</label>
              <input id="site-q" name="q" type="search" placeholder="Search the catalog" autocomplete="off" spellcheck="false" class="h-full min-w-0 flex-1 border-0 bg-transparent text-ui text-ink outline-none" />
              <kbd aria-hidden="true" class="slash-key flex-none rounded-key border border-line-strong bg-surface px-1.5 text-micro text-ink-4">/</kbd>
            </form>
            <a href="/#find" aria-label="Search the catalog" class="-mr-2 ml-auto grid size-10 place-items-center rounded-control text-ink-3 hover:bg-fill hover:text-ink pointer-coarse:size-11 md:hidden">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d={searchIcon} /></svg>
            </a>
          </>
        )}
        <nav aria-label="Main" class="flex gap-1 text-ui font-medium">
          {nav.map(([label, href]) => (
            <a href={href} aria-current={current(href)} class="rounded-control px-3 py-2 text-ink-3 no-underline transition-colors duration-150 hover:bg-fill hover:text-ink pointer-coarse:py-3 aria-[current]:bg-fill aria-[current]:text-ink">{label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main" class="mx-auto w-full max-w-sheet grow px-4 pb-18 md:px-8">
      <slot />
    </main>
    <footer class="border-t border-line bg-surface">
      <div class="mx-auto grid max-w-sheet gap-x-10 gap-y-7 px-4 py-8 text-caption text-ink-4 md:px-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
        <p class="max-w-[48ch]">
          <a href="/" class="relative font-bold tracking-(--text-wordmark--letter-spacing) text-ink no-underline hover:text-ink pointer-coarse:py-4">{SITE.name}</a> · {SITE.note}
        </p>
        <nav aria-labelledby="footer-sections">
          <h2 id="footer-sections" class="text-label uppercase text-meta">Sections</h2>
          <ul class="mt-2 gap-x-8 sm:columns-2 md:columns-3">
            {sections.map((s) => (
              <li class="flex break-inside-avoid items-baseline justify-between gap-3">
                <a href={`/categories/${s.id}`} class="py-1 text-ink-3 no-underline hover:text-ink hover:underline pointer-coarse:py-3.25">{s.data.name}</a>
                <span class="font-mono text-micro text-meta">{s.count}</span>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </footer>
    <script>
      // One "/" handler for the whole site: the page's main search if it has one, else the header's.
      import { applySlash, isSlash, slashOn, slashTarget } from '../lib/slash';
      document.addEventListener('astro:page-load', () => applySlash());
      addEventListener('keydown', (e) => {
        if (!isSlash(e) || !slashOn()) return;
        const field = slashTarget();
        if (!field) return;
        e.preventDefault();
        field.focus();
      });
    </script>
  </body>
</html>
