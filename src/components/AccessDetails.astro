---
// The Access box's definition list: links, section, tags and listed date.
import AccessLabel from './AccessLabel';
import type { Category, Tool } from '../lib/data';
interface Props { tool: Tool; category: Category; class?: string }
const { tool, category, class: className } = Astro.props;
const d = tool.data;
const access: [string, string][] = [
  ...(d.website ? [['Website', d.website] as [string, string]] : []),
  ...(d.repo ? [['Repository', d.repo] as [string, string]] : []),
  ...d.links.map((l) => [l.label, l.url] as [string, string]),
];
const coarse = 'pointer-coarse:py-2';
---
<dl class:list={['grid gap-y-3 text-label', className]}>
  {access.map(([label, url]) => (
    <div>
      <dt class="font-bold">{label}</dt>
      <dd class="font-mono [overflow-wrap:anywhere]"><a href={url} rel="noopener" class:list={['link', coarse]}><AccessLabel url={url} /></a></dd>
    </div>
  ))}
  <div>
    <dt class="font-bold">Filed under</dt>
    <dd><a href={`/categories/${category.id}`} class:list={['link', coarse]}>{category.data.name}</a></dd>
  </div>
  {d.tags.length > 0 && (
    <div>
      <dt class="font-bold">Tags</dt>
      <dd class="mt-1 flex flex-wrap gap-x-3 gap-y-1 font-mono pointer-coarse:gap-y-3">
        {d.tags.map((tag) => <a href={`/?q=${encodeURIComponent(tag)}`} class:list={['link', coarse]}>{tag}</a>)}
      </dd>
    </div>
  )}
  <div>
    <dt class="font-bold">Listed</dt>
    <dd class="text-ink-2"><time datetime={d.added.toISOString().slice(0, 10)}>{d.added.toISOString().slice(0, 10)}</time></dd>
  </div>
</dl>
