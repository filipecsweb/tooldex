---
// The catalog's masthead. "full" on the home page, "compact" everywhere else.
import { SITE } from '../site';
interface Props { size?: 'full' | 'compact'; entries?: number; sections?: number }
const { size = 'compact', entries = 0, sections = 0 } = Astro.props;
const nav = [
  ['Catalog', '/'],
  ['Sections', '/categories'],
] as const;
const here = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/');
// The page itself is "page"; a page inside the section (a section page under /categories) is "true".
const current = (href: string) => (here === href ? 'page' : href !== '/' && here.startsWith(`${href}/`) ? 'true' : undefined);
---
<header class="mx-auto max-w-sheet px-4 sm:px-6">
  {size === 'full' ? (
    <>
      <div class="flex items-baseline justify-between gap-4 py-3 text-label">
        <p class="font-semibold text-ink-2">{SITE.tagline}</p>
        <nav aria-label="Main" class="flex gap-5 font-bold">
          {nav.map(([label, href]) => <a href={href} aria-current={current(href)} class="no-underline hover:underline aria-[current]:underline">{label}</a>)}
        </nav>
      </div>
      <div class="rule-2 grid items-end gap-x-10 gap-y-4 pb-6 pt-4 lg:grid-cols-12">
        <h1 class="text-display lg:col-span-6">
          {SITE.name}
        </h1>
        <div class="lg:col-span-6">
          <p class="max-w-[52ch] font-serif text-body leading-normal">
            A catalog of agent tooling: skills, plugins, subagents, MCP servers and CLIs for Claude Code, Codex and the rest. Each entry says what the tool does, when to reach for it, and where to get it.
          </p>
          <p class="mt-3 text-label font-semibold text-ink-2">{entries} {entries === 1 ? 'entry' : 'entries'} in {sections} {sections === 1 ? 'section' : 'sections'}</p>
        </div>
      </div>
    </>
  ) : (
    <div class="flex items-baseline justify-between gap-4 py-4">
      <a href="/" class="text-wordmark text-ink no-underline">{SITE.name}</a>
      <nav aria-label="Main" class="flex gap-5 text-label font-bold">
        {nav.map(([label, href]) => <a href={href} aria-current={current(href)} class="no-underline hover:underline aria-[current]:underline">{label}</a>)}
      </nav>
    </div>
  )}
  <div class="rule-4"></div>
</header>
