---
// The catalog's masthead. "full" on the home page, "compact" everywhere else.
import { SITE } from '../site';
interface Props { size?: 'full' | 'compact'; entries?: number; sections?: number }
const { size = 'compact', entries = 0, sections = 0 } = Astro.props;
const nav = [
  ['Catalog', '/'],
  ['Sections', '/categories'],
] as const;
const here = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/');
---
<header class="mx-auto max-w-[1320px] px-4 sm:px-6">
  {size === 'full' ? (
    <>
      <div class="flex items-baseline justify-between gap-4 py-3 text-[0.9375rem]">
        <p class="font-semibold text-ink-2">{SITE.tagline}</p>
        <nav aria-label="Main" class="flex gap-5 font-bold">
          {nav.map(([label, href]) => <a href={href} aria-current={here === href ? 'page' : undefined} class="no-underline hover:underline aria-[current=page]:underline">{label}</a>)}
        </nav>
      </div>
      <div class="rule-2 grid items-end gap-x-10 gap-y-4 pb-6 pt-4 lg:grid-cols-12">
        <h1 class="text-[clamp(3.75rem,13vw,6rem)] font-black leading-[0.82] tracking-[-0.045em] lg:col-span-6">
          {SITE.name}
        </h1>
        <div class="lg:col-span-6">
          <p class="max-w-[52ch] font-serif text-[1.1875rem] leading-[1.5]">
            A catalog of agent tooling: skills, plugins, subagents, MCP servers and CLIs for Claude Code, Codex and the rest. Each entry says what the tool does, when to reach for it, and where to get it.
          </p>
          <p class="mt-3 font-mono text-[0.9375rem] text-ink-2">{entries} {entries === 1 ? 'entry' : 'entries'} in {sections} {sections === 1 ? 'section' : 'sections'}</p>
        </div>
      </div>
    </>
  ) : (
    <div class="flex items-baseline justify-between gap-4 py-4">
      <a href="/" class="text-[2.125rem] font-black leading-none tracking-[-0.045em] text-ink no-underline">{SITE.name}</a>
      <nav aria-label="Main" class="flex gap-5 text-[0.9375rem] font-bold">
        {nav.map(([label, href]) => <a href={href} aria-current={here === href ? 'page' : undefined} class="no-underline hover:underline aria-[current=page]:underline">{label}</a>)}
      </nav>
    </div>
  )}
  <div class="rule-4"></div>
</header>
