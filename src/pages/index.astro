---
import Base from '../layouts/Base.astro';
import Directory from '../components/Directory';
import { getCategories, getTools } from '../lib/data';
import { toIndex } from '../lib/tool-index';
import { websiteLd } from '../lib/jsonld';
import { SITE } from '../site';

const tools = await getTools();
const categories = await getCategories(tools);
// ponytail: the full index is inlined as island props; switch to fetching /tools.json past ~200 tools.
const index = await toIndex(tools, categories);
const sections = categories.map((c) => ({ id: c.id, name: c.data.name, count: c.count }));
---
<Base jsonLd={[websiteLd(Astro.site!)]}>
  <section aria-labelledby="title" class="pb-6 pt-10 md:pb-8 md:pt-12">
    <h1 id="title" class="max-w-[20ch] text-display">{SITE.tagline}</h1>
    <p class="mt-3.5 max-w-[62ch] text-lead text-ink-4">{SITE.lead}</p>
  </section>
  <script is:inline data-astro-rerun>
    // Cleared by the directory once it has read the URL; the timeout is a safety net if it never hydrates.
    if (location.search) {
      document.documentElement.dataset.filtering = '';
      setTimeout(() => delete document.documentElement.dataset.filtering, 3000);
    }
  </script>
  <Directory client:load tools={index} sections={sections} />
</Base>
