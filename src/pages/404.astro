---
import Base from '../layouts/Base.astro';
import { getCategories } from '../lib/data';
const categories = await getCategories();
---
<Base title="Not in the catalog" noindex>
  <section class="max-w-[60ch] pb-10 pt-12">
    <h1 class="text-headline">Not in the catalog</h1>
    <p class="mt-5 font-serif text-body leading-normal">
      There is no page at this address. The tool may have been renamed or removed. Search the <a href="/" class="link">whole catalog</a>, or start from a section.
    </p>
  </section>
  <ul class="rule-4 index-run pt-6">
    {categories.map((c) => (
      <li><a href={`/categories/${c.id}`} class="index-item">{c.data.name} <span class="index-count">{c.count}</span></a></li>
    ))}
  </ul>
</Base>
