---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArrowOut from '../../components/ArrowOut';
import AccessDetails from '../../components/AccessDetails.astro';
import Ink from '../../components/Ink';
import Plate from '../../components/Plate';
import { getCategories, getTools, primaryUrl, relatedTools, type Tool } from '../../lib/data';
import { toIndex } from '../../lib/tool-index';
import { captionFor, ctaLabel } from '../../lib/format';
import { breadcrumbLd, toolLd } from '../../lib/jsonld';

export async function getStaticPaths() {
  const tools = await getTools();
  return tools.map((tool) => ({ params: { slug: tool.id }, props: { tool, all: tools } }));
}

const { tool, all } = Astro.props as { tool: Tool; all: Tool[] };
const d = tool.data;
const categories = await getCategories(all);
const category = categories.find((c) => c.id === d.category.id)!;
const [entry] = await toIndex([tool], categories);
const related = await toIndex(relatedTools(tool, all), categories);
const provenance = import.meta.glob<{ prompt: string }>('/src/content/tools/*/thumb.webp.json', { eager: true, import: 'default' });
const caption = captionFor(provenance[`/src/content/tools/${tool.id}/thumb.webp.json`]?.prompt);
const { Content } = await render(tool);
const og = d.thumbnail ? (await getImage({ src: d.thumbnail, width: 1200, height: 630, fit: 'cover', format: 'png' })).src : undefined;
const site = Astro.site!;

---
<Base
  title={`${d.name}: ${category.data.name} tool for AI agents`}
  description={d.tagline}
  image={og}
  jsonLd={[
    toolLd(site, tool, category.data.name, og),
    breadcrumbLd(site, [['Catalog', '/'], ['Sections', '/categories'], [category.data.name, `/categories/${category.id}`], [d.name, `/tools/${tool.id}`]]),
  ]}
>
  <nav aria-label="Breadcrumb" class="pt-4 text-label">
    <ol class="flex flex-wrap gap-x-2 text-ink-3">
      <li><a href="/" class="font-semibold text-ink no-underline hover:underline pointer-coarse:py-2">Catalog</a> /</li>
      <li><a href="/categories" class="font-semibold text-ink no-underline hover:underline pointer-coarse:py-2">Sections</a> /</li>
      <li><a href={`/categories/${category.id}`} class="font-semibold text-ink no-underline hover:underline pointer-coarse:py-2">{category.data.name}</a> /</li>
      <li aria-current="page" class="text-ink-2">{d.name}</li>
    </ol>
  </nav>

  <article class="grid grid-cols-[minmax(0,1fr)] gap-x-12 gap-y-8 pt-6 lg:grid-cols-12">
    <header class="lg:col-span-8">
      <div class="flex min-w-0 items-center gap-4">
        {d.icon && d.thumbnail && <Image src={d.icon} width={64} height={64} alt="" class="size-14 border-2 border-ink bg-paper-2 object-cover" />}
        <h1 class="min-w-0 text-headline">{d.name}</h1>
      </div>
      <p class="mt-5 max-w-[40ch] font-serif text-lead text-ink-2">{d.tagline}</p>
    </header>

    <aside class="lg:col-span-4 lg:col-start-9 lg:row-span-2 lg:row-start-1">
      <div class="border-[3px] border-ink p-5 lg:sticky lg:top-6">
        <h2 class="text-label font-black uppercase tracking-[0.08em] text-spot">Access</h2>
        <a
          href={primaryUrl(tool)}
          rel="noopener"
          class="mt-3 flex items-center justify-between gap-3 bg-ink px-4 py-3 text-body-sm font-extrabold text-paper no-underline transition-colors duration-150 hover:bg-spot"
        >
          {ctaLabel(Boolean(d.website))}
          <ArrowOut />
        </a>
        <AccessDetails tool={tool} category={category} class="mt-5 hidden lg:grid" />
      </div>
    </aside>

    <div class="lg:col-span-8">
      <div class="review">
        <Content />
      </div>

      {d.thumbnail ? (
        <figure class="mt-8">
          <div class="plate" data-developed>
            <Image
              src={d.thumbnail}
              widths={[640, 960, 1280, 1600]}
              sizes="(min-width: 1100px) 840px, 100vw"
              alt={`${d.name}, as shown on its ${d.website ? 'website' : 'repository'}`}
              class="absolute inset-0 size-full object-cover object-top mix-blend-multiply"
            />
          </div>
          {caption && <figcaption class="mt-2 text-label text-ink-3">{caption}</figcaption>}
        </figure>
      ) : (
        <div class="mt-8"><Plate tool={entry} developed quiet /></div>
      )}

      <section aria-labelledby="details" class="rule-2 mt-10 pt-3 lg:hidden">
        <h2 id="details" class="text-label font-extrabold">Details</h2>
        <AccessDetails tool={tool} category={category} class="mt-3" />
      </section>
    </div>

  </article>

  {related.length > 0 && (
    <section aria-labelledby="see-also" class="rule-4 mt-16 pt-4">
      <h2 id="see-also" class="text-title font-black">See also</h2>
      <ul class="mt-5 grid gap-x-10 gap-y-5 md:grid-cols-2">
        {related.map((r) => (
          <li class="rule-2 pt-3">
            <a href={`/tools/${r.slug}`} class="group flex gap-4 text-ink no-underline">
              {r.icon && <Ink src={r.icon} ink={r.iconInk} width={48} height={48} className="size-12 shrink-0 border-2 border-ink bg-paper-2" />}
              <span>
                <span class="block text-[1.25rem] font-extrabold leading-tight group-hover:underline">{r.name}</span>
                <span class="mt-1 block font-serif text-body-sm leading-snug text-ink-2">{r.tagline}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>
