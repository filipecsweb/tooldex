---
import Base from '../../layouts/Base.astro';
import Catalog from '../../components/Catalog.astro';
import { getCategories, getTools, type Category, type Tool } from '../../lib/data';
import { toIndex } from '../../lib/tool-index';
import { breadcrumbLd, itemListLd } from '../../lib/jsonld';

// Only categories with at least one tool get a page (getCategories filters empty ones).
export async function getStaticPaths() {
  const tools = await getTools();
  const categories = await getCategories(tools);
  return categories.map((category) => ({
    params: { slug: category.id },
    props: { category, categories, tools: tools.filter((t) => t.data.category.id === category.id) },
  }));
}

const { category, categories, tools } = Astro.props as { category: Category; categories: Category[]; tools: Tool[] };
// The home directory scoped to this section: the island gets only its tools.
const index = await toIndex(tools, categories);
const sections = categories.map((c) => ({ id: c.id, name: c.data.name, count: c.count }));
const site = Astro.site!;
const crumb = 'text-ink-3 no-underline hover:text-ink hover:underline pointer-coarse:inline-block pointer-coarse:py-3.25';
---
<Base
  title={`${category.data.name} tools for AI agents`}
  description={category.data.description}
  jsonLd={[
    breadcrumbLd(site, [['Catalog', '/'], ['Sections', '/categories'], [category.data.name, `/categories/${category.id}`]]),
    itemListLd(site, tools),
  ]}
>
  <nav aria-label="Breadcrumb" class="pt-5 text-caption">
    <ol class="flex flex-wrap items-baseline gap-x-2 text-meta">
      <li><a href="/" class={crumb}>Catalog</a></li>
      <li aria-hidden="true">/</li>
      <li><a href="/categories" class={crumb}>Sections</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page" class="text-ink-4">{category.data.name}</li>
    </ol>
  </nav>
  <section aria-labelledby="title" class="pb-6 pt-5 md:pb-8 md:pt-6">
    <h1 id="title" class="max-w-[20ch] text-display">{category.data.name}</h1>
    <p class="mt-3.5 max-w-[62ch] text-lead text-ink-4">{category.data.description}</p>
  </section>
  <Catalog tools={index} sections={sections} scope={category.id} />
</Base>
