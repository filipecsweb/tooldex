---
import Base from '../../layouts/Base.astro';
import ToolCard from '../../components/ToolCard';
import { getCategories, getTools, type Category, type Tool } from '../../lib/data';
import { toIndex } from '../../lib/tool-index';
import { breadcrumbLd, itemListLd } from '../../lib/jsonld';

// Only categories with at least one tool get a page (getCategories filters empty ones).
export async function getStaticPaths() {
  const tools = await getTools();
  const categories = await getCategories(tools);
  return categories.map((category) => ({
    params: { slug: category.id },
    props: { category, categories, tools: tools.filter((t) => t.data.category.id === category.id) },
  }));
}

const { category, categories, tools } = Astro.props as { category: Category; categories: Category[]; tools: Tool[] };
// ponytail: unpaginated; paginate() past ~80 tools per category.
const entries = await toIndex(tools, categories);
const others = categories.filter((c) => c.id !== category.id);
const site = Astro.site!;
---
<Base
  title={`${category.data.name} tools for AI agents`}
  description={category.data.description}
  jsonLd={[
    breadcrumbLd(site, [['Catalog', '/'], ['Sections', '/categories'], [category.data.name, `/categories/${category.id}`]]),
    itemListLd(site, tools),
  ]}
>
  <nav aria-label="Breadcrumb" class="pt-4 text-label">
    <ol class="flex flex-wrap gap-x-2 text-ink-3">
      <li><a href="/" class="font-semibold text-ink no-underline hover:underline pointer-coarse:py-2">Catalog</a> /</li>
      <li><a href="/categories" class="font-semibold text-ink no-underline hover:underline pointer-coarse:py-2">Sections</a> /</li>
      <li aria-current="page" class="text-ink-2">{category.data.name}</li>
    </ol>
  </nav>

  <header class="grid items-end gap-x-12 gap-y-4 pb-8 pt-6 lg:grid-cols-12">
    <h1 class="text-headline lg:col-span-7">{category.data.name}</h1>
    <div class="lg:col-span-5">
      <p class="max-w-[52ch] font-serif text-body leading-normal">{category.data.description}</p>
      <p class="mt-3 text-label font-semibold text-ink-2">{tools.length} {tools.length === 1 ? 'entry' : 'entries'}</p>
    </div>
  </header>

  <h2 class="sr-only">Entries</h2>
  <ul class="rule-4 grid grid-cols-1 gap-x-10 gap-y-14 pt-3 sm:grid-cols-2 lg:grid-cols-3">
    {entries.map((t, i) => <li class={i === 0 ? 'sm:col-span-2 lg:col-span-3' : undefined}><ToolCard tool={t} eager={i < 3} lead={i === 0} filed={false} /></li>)}
  </ul>

  {others.length > 0 && (
    <section aria-labelledby="other-sections" class="rule-4 mt-20 pt-4">
      <h2 id="other-sections" class="text-title font-black">Other sections</h2>
      <ul class="index-run mt-4">
        {others.map((c) => (
          <li><a href={`/categories/${c.id}`} class="index-item">{c.data.name} <span class="index-count">{c.count}</span></a></li>
        ))}
      </ul>
    </section>
  )}
</Base>
